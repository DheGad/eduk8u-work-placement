# ============================================================
# EDUK8U Work Placement Intelligence Platform - Backend
# Copy this file to .env and fill in all values before running
# ============================================================

# ----- Application -----
NODE_ENV=development
PORT=3000
API_VERSION=v1

# ----- PostgreSQL Database -----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eduk8u
DB_USER=eduk8u_user
DB_PASSWORD=eduk8u_password_dev
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# ----- JWT Authentication -----
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_me_with_a_64_byte_random_hex_string
JWT_REFRESH_SECRET=replace_me_with_another_64_byte_random_hex_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ----- Vultr Object Storage (S3-compatible) -----
VULTR_ACCESS_KEY=your_vultr_access_key
VULTR_SECRET_KEY=your_vultr_secret_key
VULTR_BUCKET_NAME=eduk8u-documents
VULTR_ENDPOINT=https://ewr1.vultrobjects.com
VULTR_REGION=ewr1

# ----- SMTP / Email -----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@eduk8u.com
SMTP_PASS=your_smtp_password
SMTP_FROM="EDUK8U Platform <noreply@eduk8u.com>"

# ----- CORS / Frontend -----
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ----- Rate Limiting -----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ----- Logging -----
# Levels: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info
