# ==============================================================================
# EDUK8U Production Environment Configuration Template
# COPY TO .env AND POPULATE SECRETS BEFORE DEPLOYMENT
# ==============================================================================

# Core API
NODE_ENV=production
PORT=3000
API_VERSION=v1

# Security / Auth
# Must be at least 32-character high entropy random strings
JWT_SECRET=generate_a_secure_random_string_here_123!
JWT_REFRESH_SECRET=generate_a_different_secure_random_string_here_456!

# Allowed Origins (CORS) - Comma separated list of exact URLs
ALLOWED_ORIGINS=https://app.eduk8u.com,https://icqa.eduk8u.com

# PostgreSQL Database Configuration
PGUSER=eduk8u_prod_user
PGPASSWORD=super_secure_db_password
PGDATABASE=eduk8u_prod

# Email Infrastructure (Leave SendGrid blank if Postmark is primary)
POSTMARK_SERVER_TOKEN=your_postmark_token_here
SENDGRID_API_KEY=your_sendgrid_key_here
EMAIL_FROM_ADDRESS=notifications@eduk8u.com

# Rate Limiting (Optional Overrides)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
